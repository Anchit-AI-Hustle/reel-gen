# Reel Gen V2 — Environment Variables (Cloudflare D1 + Workers + R2 + Vercel)
# Zero Neon, Zero Supabase, Free-Tier Stack
# Configure in Vercel project prj_efOs4Q6F6m2pczlNQpQDVeI6iwbM (server-side only)

APP_URL=https://reel-gen.anchit-tandon.com

# Cloudflare Resources (populate after provisioning via Wrangler)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_DB_API_URL=
CLOUDFLARE_DB_API_TOKEN=
CLOUDFLARE_R2_BUCKET=reel-gen-media
CLOUDFLARE_R2_ENDPOINT=

# Security & Session Signing (32+ byte random hex)
AUTH_SECRET=
ENCRYPTION_KEY=
WORKER_AUTH_SECRET=

# Cloud Drive OAuth Credentials (leave blank until owner-registered apps are configured)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Optional Local/Worker Cache Directory
REEL_GEN_DATA_DIR=.reel-gen-data
