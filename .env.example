# Reel Gen V2 — Environment Variables (Zero Supabase, Free-Tier Stack)
# Copy to .env.local for development or configure in Vercel project prj_efOs4Q6F6m2pczlNQpQDVeI6iwbM

# Neon PostgreSQL (Required for production persistence)
DATABASE_URL=
DATABASE_URL_DIRECT=

# Application URLs
APP_URL=https://reel-gen.anchit-tandon.com
BETTER_AUTH_URL=https://reel-gen.anchit-tandon.com
BETTER_AUTH_SECRET=

# Security & Worker Secrets (32+ byte random hex)
ENCRYPTION_KEY=
WORKER_AUTH_SECRET=

# Cloud Drive OAuth Credentials (Owner-registered apps; leave blank until configured)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Optional Storage Directory for Local/Worker Media Cache
REEL_GEN_DATA_DIR=.reel-gen-data
