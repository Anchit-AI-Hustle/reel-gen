{
  "name": "reel-gen",
  "version": "2.0.0",
  "private": true,
  "description": "Reel Gen V2 — AI-assisted professional video production studio powered by Neon PostgreSQL and FFmpeg",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs && node --experimental-strip-types --test tests/*.test.ts",
    "test:unit": "node --experimental-strip-types --test tests/unit.test.ts tests/constraints.test.ts tests/reference-matching.test.ts tests/cloud-and-intake.test.ts",
    "test:render": "node --experimental-strip-types --test tests/ffmpeg-render.test.ts",
    "db:migrate": "node --experimental-strip-types scripts/migrate.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.0",
    "lucide-react": "^0.468.0",
    "next": "^15.2.4",
    "pg": "^8.13.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.2"
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "not dead"
  ],
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.14",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.11.11",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "tailwindcss": "^4.0.14",
    "typescript": "^5.8.2"
  }
}
