{
  "name": "reel-gen",
  "version": "2.1.0",
  "private": true,
  "description": "Reel Gen V2 — AI-assisted professional video production studio powered by Cloudflare D1, Workers, R2, and FFmpeg",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs && node --experimental-strip-types --test tests/*.test.ts",
    "db:migrate:local": "wrangler d1 migrations apply reel-gen-db --local --config worker/wrangler.toml",
    "db:migrate:remote": "wrangler d1 migrations apply reel-gen-db --remote --config worker/wrangler.toml",
    "worker:dev": "wrangler dev --config worker/wrangler.toml",
    "worker:deploy": "wrangler deploy --config worker/wrangler.toml"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "^15.2.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.2"
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "not dead"
  ],
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.14",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "tailwindcss": "^4.0.14",
    "typescript": "^5.8.2"
  }
}
